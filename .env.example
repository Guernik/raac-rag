# Copy to .env (gitignored) for local runs: cp .env.example .env
# Variables already set in the environment win over this file.

# Anthropic API key. RAAC_ANTHROPIC_API_KEY is also accepted.
ANTHROPIC_API_KEY=

# Optional: override the model of one stage (see src/raac/models.toml).
# RAAC_MODEL_INDEXING=claude-haiku-4-5
# RAAC_MODEL_SEARCH=claude-opus-5-5
# RAAC_MODEL_ANSWER=claude-opus-5-5
